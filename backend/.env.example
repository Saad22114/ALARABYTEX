# Django
# DEBUG=False في الإنتاج. لا تتركه True على خادم مكشوف.
DEBUG=True

# مطلوب في الإنتاج — Django يرفض الإقلاع بدونه. ولّده بـ:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# في التطوير، إن تُرك فارغاً يُولَّد مفتاح عشوائي لكل تشغيل (تُلغى الجلسات
# عند إعادة التشغيل، وهذا مقبول للتطوير فقط).
SECRET_KEY=

# Production: list the real domains. "*" is refused while DEBUG=False.
ALLOWED_HOSTS=*

# PostgreSQL
DB_NAME=fabric_arabi
DB_USER=postgres
# غيّره. القيمة أدناه للتطوير المحلي فقط ولا تصلح لأي خادم مكشوف.
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# Frontend origin
FRONTEND_URL=http://localhost:3000

# حساب المدير (يستخدمه backend/start.sh فقط)
# ADMIN_USERNAME مطلوب — لا قيمة افتراضية، وإلا حمل كل نشر نفس الحساب.
ADMIN_USERNAME=
# اتركه فارغاً ليولّد start.sh كلمة مرور عشوائية ويطبعها مرة واحدة.
# اضبطه فقط إذا أردت كلمة مرور ثابتة معروفة لك.
ADMIN_PASSWORD=
ADMIN_NAME=مدير النظام

# Optional WhatsApp Cloud API integration for opted-in customer welcome messages.
# Configure only after adding an approved template with one body text variable
# (the customer's name) and a WhatsApp Business Platform phone number.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_WELCOME_TEMPLATE_NAME=customer_welcome
WHATSAPP_WELCOME_TEMPLATE_LANGUAGE=ar
WHATSAPP_DEFAULT_COUNTRY_CODE=968
